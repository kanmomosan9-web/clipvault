# ---- 共通 ----
DISCORD_TOKEN=ここにbotトークン
GUILD_ID=あなたのサーバーID
STORAGE_CHANNEL_IDS=保管チャンネルID,複数ある場合はカンマ区切り

# ---- ジョブAPI（VM側のbotが待ち受ける）----
API_ENABLED=1
API_HOST=127.0.0.1
API_PORT=8787
WORKER_TOKEN=openssl rand -hex 32 などで生成した長い文字列

# ---- 文字起こし ----
AUTO_TRANSCRIBE=1
PREFERRED_MODEL=large-v3
WHISPER_LANG=ja

# ---- 自宅PC(GPU)ワーカー専用。VM側では設定しない ----
# WORKER_API_URL=http://127.0.0.1:8787
# WORKER_TIER=gpu
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16
# AUTO_UPGRADE=1
